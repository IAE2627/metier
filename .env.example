# Copier ce fichier en .env et remplir avec vos identifiants francetravail.io
# (Mes applications -> Créer une application -> API « Offres d'emploi v2 »)
FT_CLIENT_ID=PAR_votre_application_xxxxxxxx
FT_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Autres sources (facultatives : une source sans clé est simplement ignorée)
# La bonne alternance : https://api.apprentissage.beta.gouv.fr/compte/profil (clé « production »)
LBA_API_KEY=
# Adzuna : https://developer.adzuna.com (Register)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Jooble : https://jooble.org/api/about (formulaire)
JOOBLE_KEY=
